# Phase 2 (backend) — not used yet by Phase 1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Pose model served from /public (downloaded by `npm run setup:mediapipe`).
# Variant: lite (fastest) | full (default, better with occlusion) | heavy (most accurate, slowest).
# Re-run `npm run setup:mediapipe` after changing it.
NEXT_PUBLIC_POSE_MODEL_VARIANT=full
# Optional: override the model path entirely.
# NEXT_PUBLIC_POSE_MODEL_URL=/mediapipe/models/pose_landmarker_full.task

# YOLO-pose (experimental). Export with:
#   yolo export model=yolo11s-pose.pt format=onnx imgsz=640 opset=17 simplify=True
# then place the file here (it is not downloaded automatically).
# NEXT_PUBLIC_YOLO_MODEL_URL=/models/yolo/yolo11s-pose.onnx
# Run the live app on YOLO instead of MediaPipe: mediapipe (default) | yolo. `?pose=yolo` in the URL does it for one session.
# NEXT_PUBLIC_POSE_BACKEND=yolo
